<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme.
         IMPORTANT: AppTheme.NoActionBar MUST keep a Theme.AppCompat* parent.
         BridgeActivity is an AppCompatActivity and calls setTheme(R.style.AppTheme_NoActionBar)
         before setContentView — a non-AppCompat parent here crashes instantly on launch
         ("You need to use a Theme.AppCompat theme (or descendant) with this activity"). -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight">
        <item name="android:windowBackground">#0A0E1A</item>
        <item name="android:statusBarColor">#0A0E1A</item>
        <item name="android:navigationBarColor">#0A0E1A</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#0A0E1A</item>
        <item name="android:statusBarColor">#0A0E1A</item>
        <item name="android:navigationBarColor">#0A0E1A</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
