{
  "name": "idea-bucket",
  "version": "1.1.0",
  "description": "By the way (راستی) - catch ideas in Name - Description buckets",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.mkdirSync('www');fs.copyFileSync('index.html','www/index.html');console.log('www/ ready')\"",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  }
}
